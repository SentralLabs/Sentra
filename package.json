{
  "name": "@_bisht_akash/sentra",
  "version": "1.2.0",
  "description": "Authentication and authorization framework for TypeScript applications",
  "author": "Akash Bisht",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SentralLabs/Sentra.git"
  },
  "homepage": "https://github.com/SentralLabs/Sentra#readme",
  "bugs": {
    "url": "https://github.com/SentralLabs/Sentra/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "authentication",
    "authorization",
    "jwt",
    "typescript",
    "auth"
  ],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
